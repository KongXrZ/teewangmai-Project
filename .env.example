# Copy to .env.local; use local values from npm run db:status after db:start.
# See docs/backend-setup.md. Do not overwrite an existing .env.local.
# The current landing page runs without these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEXT_PUBLIC_ values are visible in the browser.
# Never put a Supabase secret/service-role key or a PostgreSQL password here.
